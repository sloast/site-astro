---
const { title, href, image } = Astro.props;
---

<div class="card" @click={`window.location.href = ${href}`}>
    <div class="top">
        <h3>{title}</h3>
    </div>
    <div class="body">
        <slot />
    </div>
</div>

<style>
    .card {
        position: relative;
        z-index: 0;

        display: flex;
        flex-direction: column;
        justify-content: stretch;

        min-height: 15rem;
        width: 20rem;

        overflow: clip;

        border-radius: 1rem;
        border: 2px solid gray;

        text-align: center;
    }

    .card:hover {
        box-shadow: 0 0 2em #0000ff;
    }

    .top {
    }
</style>
