<div class="root">
    <canvas
        id="shader-bg"
        x-data
        x-init="setupShaderCanvas($el, 'shader/perlin.glsl')"
    >
        shader failed to load :/
    </canvas>
    <div class="overlay">
        <h1>hi, i'm adam</h1>

        <p is:raw>
            i'm a programmer, musician, bellringer, language learner, and a few
            other things.
        </p>
    </div>
</div>
<script src="../js/runshader.js"></script>

<style>
    canvas {
        position: absolute;
        inset: 0;
        z-index: -10;
    }

    h1,
    p {
        border-radius: var(--rad);
        background-color: var(--bg-light);
        padding: 1rem;
    }

    h1 {
        font-size: 2rem;
        text-wrap: nowrap;
    }

    p {
        max-width: 80%;
    }

    div.root {
        position: relative;
        z-index: 0;
        min-height: 18rem;
        overflow: clip;
    }

    div.overlay {
        max-width: 1000px;
        margin: auto;

        pointer-events: none;

        position: absolute;
        inset: 0;

        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: center;
        text-align: center;
    }
</style>
